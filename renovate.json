{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly"
  ],
  "enabledManagers": ["argocd", "kubernetes", "github-actions", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Image tags pinned under helm.valuesObject, marked with a renovate comment",
      "managerFilePatterns": [
        "/^applications/.+\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*tag: (?<currentValue>\\S+)"
      ]
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "/^applications/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^applications/.+\\.yaml$/"
    ]
  },
  "automerge": false,
  "labels": ["dependencies"],
  "assignees": ["jangroth"],
  "reviewers": ["jangroth"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Group minor and patch Helm chart updates to reduce PR noise",
      "matchManagers": ["argocd"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Helm chart minor/patch updates",
      "groupSlug": "helm-minor-patch"
    },
    {
      "description": "Only plain vX.Y.Z releases; skip rc, per-arch and desktop tags",
      "matchDatasources": ["docker"],
      "matchDepNames": ["nousresearch/hermes-agent", "tailscale/tailscale", "ghcr.io/betterleaks/betterleaks", "infisical/infisical"],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "description": "Only plain X.Y.Z releases; skip per-arch and windows tags",
      "matchDatasources": ["docker"],
      "matchDepNames": ["infisical/cli"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "description": "Postgres/Redis majors need a manual data migration",
      "matchDatasources": ["docker"],
      "matchDepNames": ["postgres", "redis"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
